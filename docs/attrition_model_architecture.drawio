<mxfile host="drawio-plugin" modified="2026-04-20T06:00:11.990Z" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36" version="22.1.22" etag="RVquhGDdUcs2vJDIDF18" type="embed" pages="2">
  <diagram id="overview-vertical" name="Overview">
    <mxGraphModel dx="2558" dy="1685" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="2600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ov_title" value="HR Attrition Model Overview" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=22;" parent="1" vertex="1">
          <mxGeometry x="420" y="20" width="760" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ov_subtitle" value="This page is intentionally simple: follow the main line from top to bottom.&#xa;The model first reads employee data and policy data, then converts policy text into structured features, and finally trains a blended attrition model." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="320" y="100" width="960" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ov_note" value="Reading tip&#xa;The green boxes explain policy understanding.&#xa;The purple boxes explain employee-side processing.&#xa;The blue and orange boxes explain model training and decision making." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d79b00;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="1180" y="230" width="360" height="110" as="geometry" />
        </mxCell>
        <mxCell id="ov_1" value="1. Employee Data Input&#xa;Raw employee records with demographic, work-history, role, satisfaction, overtime, compensation, and attrition label fields." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="450" y="220" width="700" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ov_2" value="2. Employee Preprocessing and Feature Engineering&#xa;Clean columns, fill missing values, build AttritionFlag, and create interaction features such as overtime pressure, travel risk, promotion wait, role stagnation, stress score, and tenure bands." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="450" y="360" width="700" height="115" as="geometry" />
        </mxCell>
        <mxCell id="ov_3" value="3. Policy Data Input&#xa;Policy workbook containing title, body text, date information, links, and source text." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="450" y="525" width="700" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ov_4" value="4. Policy Understanding Layer&#xa;Detect policy text columns, infer target role and target department, identify policy topic, estimate sentiment, and build a clean semantic representation of each policy document." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="450" y="665" width="700" height="115" as="geometry" />
        </mxCell>
        <mxCell id="ov_5" value="5. Sentence-BERT Representation Layer&#xa;Encode each policy into dense semantic vectors, then compute policy-level scores such as semantic_score, time_weight, policy_hotness, and final policy_score." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="450" y="830" width="700" height="115" as="geometry" />
        </mxCell>
        <mxCell id="ov_6" value="6. Employee Need Profile Construction&#xa;Turn employee HR signals into a short demand-oriented policy profile, so the model can compare what an employee appears to need versus what current policies provide." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="450" y="995" width="700" height="115" as="geometry" />
        </mxCell>
        <mxCell id="ov_7" value="7. Policy-to-Employee Matching Layer&#xa;Combine Sentence-BERT semantic similarity, topic similarity, role bonus, department bonus, time weighting, and policy-strength weighting to generate employee-level policy features." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="450" y="1160" width="700" height="115" as="geometry" />
        </mxCell>
        <mxCell id="ov_8" value="8. Unified Training Table&#xa;Merge employee HR features, interaction features, policy matching features, topic exposure features, and macro policy index into one training table." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="450" y="1325" width="700" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ov_9" value="9. Blended Attrition Model Training&#xa;Use a tabular ensemble made of LightGBM, Logistic Regression, and ExtraTrees, then improve it with OOF blending, meta features, and a second-level meta learner." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cce5ff;strokeColor=#6c8ebf;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="450" y="1475" width="700" height="105" as="geometry" />
        </mxCell>
        <mxCell id="ov_10" value="10. Decision Strategy Layer&#xa;Optimize thresholds on validation probabilities and use a segment-aware rule so that high-risk employees and standard employees do not share exactly the same decision boundary." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="450" y="1630" width="700" height="105" as="geometry" />
        </mxCell>
        <mxCell id="ov_11" value="11. Final Outputs&#xa;Generate the prediction workbook, SHAP summary, Top3 risk-driver workbook, model metrics workbook, feature-importance output, and policy-role matching chart." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="450" y="1785" width="700" height="105" as="geometry" />
        </mxCell>
        <mxCell id="ove1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;" parent="1" source="ov_1" target="ov_2" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ove2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;" parent="1" source="ov_2" target="ov_3" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ove3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;" parent="1" source="ov_3" target="ov_4" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ove4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;" parent="1" source="ov_4" target="ov_5" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ove5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;" parent="1" source="ov_5" target="ov_6" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ove6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;" parent="1" source="ov_6" target="ov_7" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ove7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;" parent="1" source="ov_7" target="ov_8" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ove8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;" parent="1" source="ov_8" target="ov_9" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ove9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;" parent="1" source="ov_9" target="ov_10" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ove10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;" parent="1" source="ov_10" target="ov_11" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="training-vertical" name="Training Detail">
    <mxGraphModel dx="1800" dy="2600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="3200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="tr_title" value="Training Layer Detail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=22;" vertex="1" parent="1">
          <mxGeometry x="440" y="20" width="720" height="60" as="geometry" />
        </mxCell>
        <mxCell id="tr_subtitle" value="This page expands only the model-training core. It explains how the final blended attrition model is trained after the employee and policy features have already been merged." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="300" y="100" width="1000" height="60" as="geometry" />
        </mxCell>
        <mxCell id="tr_note1" value="Design idea&#xa;The model is not a single classifier.&#xa;It is a layered ensemble: base models -&gt; OOF blending -&gt; meta learner -&gt; threshold strategy." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1090" y="250" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="tr_1" value="1. Unified Feature Table&#xa;Start from the merged table that already contains employee HR fields, interaction features, policy matching features, topic exposure features, and macro_index." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="220" width="740" height="95" as="geometry" />
        </mxCell>
        <mxCell id="tr_2" value="2. ColumnTransformer Preprocessor&#xa;Numeric branch: median imputation -&gt; standard scaling.&#xa;Categorical branch: most-frequent imputation -&gt; one-hot encoding." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cce5ff;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="430" y="365" width="740" height="100" as="geometry" />
        </mxCell>
        <mxCell id="tr_3" value="3. Stratified Split&#xa;Split the data into train_valid and held-out test.&#xa;The test split is kept untouched until the final evaluation stage." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cce5ff;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="430" y="515" width="740" height="95" as="geometry" />
        </mxCell>
        <mxCell id="tr_4" value="4. LightGBM Random Search&#xa;Run RandomizedSearchCV on the train_valid matrix with 4-fold CV and ROC-AUC scoring to discover the strongest LightGBM parameter set." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cce5ff;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="430" y="660" width="740" height="100" as="geometry" />
        </mxCell>
        <mxCell id="tr_5" value="5. Build the First-Level Model Family&#xa;Create three heterogeneous base learners:&#xa;LightGBM for nonlinear tabular patterns, Logistic Regression for stable linear separation, and ExtraTrees for complementary tree behavior." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cce5ff;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="430" y="810" width="740" height="115" as="geometry" />
        </mxCell>
        <mxCell id="tr_6" value="6. Generate OOF Probabilities&#xa;Use 5-fold out-of-fold prediction for each base learner so every training sample receives probabilities from models that did not train on that sample." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cce5ff;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="430" y="975" width="740" height="100" as="geometry" />
        </mxCell>
        <mxCell id="tr_7" value="7. Search Blend Weights&#xa;Search the best mixture weights for LightGBM, Logistic Regression, and ExtraTrees.&#xa;The score already combines AUC, F1, recall, accuracy, precision, positive-rate alignment, and a complexity penalty." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="430" y="1125" width="740" height="115" as="geometry" />
        </mxCell>
        <mxCell id="tr_8" value="8. Build Meta Features&#xa;Do not pass only the three base probabilities to the second layer.&#xa;Also create blended_prob, mean_prob, std_prob, and disagreement so the second layer can reason about confidence and model conflict." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="430" y="1290" width="740" height="115" as="geometry" />
        </mxCell>
        <mxCell id="tr_9" value="9. Fit the Meta Learner&#xa;Train a scaled logistic-regression meta learner on the OOF meta-feature matrix so it learns how to combine the base model behavior more flexibly than a fixed-weight average." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="430" y="1455" width="740" height="115" as="geometry" />
        </mxCell>
        <mxCell id="tr_10" value="10. Global Threshold Optimization&#xa;Search the best validation threshold on the blended probability output.&#xa;This converts probabilities into binary attrition decisions." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="430" y="1620" width="740" height="95" as="geometry" />
        </mxCell>
        <mxCell id="tr_11" value="11. Segment Threshold Optimization&#xa;Split employees into high-risk and standard segments using employee context, then allow the two groups to use different thresholds." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="430" y="1765" width="740" height="95" as="geometry" />
        </mxCell>
        <mxCell id="tr_12" value="12. Final Refit of the Whole Stack&#xa;Refit the three base models on the full train_valid pool, attach the learned blend weights, attach the meta learner, and package everything into BlendedAttritionModel." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="1910" width="740" height="110" as="geometry" />
        </mxCell>
        <mxCell id="tr_13" value="13. Held-Out Test Evaluation&#xa;Run the final blended model on the untouched test split and report AUC, accuracy, precision, recall, F1, predicted positive rate, blend weights, and threshold strategy." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="430" y="2070" width="740" height="105" as="geometry" />
        </mxCell>
        <mxCell id="tr_14" value="14. Export and Explainability&#xa;Generate the prediction workbook, SHAP summary, Top3 risk-driver workbook, metrics workbook, feature-importance workbook, and visual charts." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="430" y="2225" width="740" height="100" as="geometry" />
        </mxCell>
        <mxCell id="tr_note2" value="Why this is stronger than a plain single model&#xa;The training core combines:&#xa;1) a tuned tree model,&#xa;2) a linear model,&#xa;3) a randomized tree model,&#xa;4) OOF blending,&#xa;5) a second-level learner, and&#xa;6) segment-aware thresholding." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1090" y="1330" width="340" height="140" as="geometry" />
        </mxCell>
        <mxCell id="tre1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="tr_1" target="tr_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tre2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="tr_2" target="tr_3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tre3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="tr_3" target="tr_4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tre4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="tr_4" target="tr_5">
          <mxGeometry relative="1" as="geometry" />
